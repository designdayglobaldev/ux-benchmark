generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  LIVE
  DRAFT
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Category {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String?
  status        Status        @default(DRAFT)
  apps          App[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  title       String
  slug        String   @unique
  description String?
  status      Status   @default(DRAFT)
  apps        App[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model App {
  id            String       @id @default(uuid())
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  name          String
  slug          String       @unique
  appLogo       String
  appThumbnail  String
  status        Status       @default(DRAFT)
  isStaffPick   Boolean      @default(false)
  isPremium     Boolean      @default(false) // When true: Requires UserTier.PREMIUM for full screen flow
  previewLimit  Int          @default(4)     // Number of screens free users can preview before lock
  sourceUrl     String?
  description   String?
  platform      String[]
  tags          String[]
  palette       Json?

  market         String[]
  targetAudience String?

  // Deep Dive Analysis
  visualUiTypography String?
  visualUiShape      String?
  visualUiImagery    String?

  experienceUxSolves  String?
  experienceUxOverall String?
  experienceUxTone    String?

  lookAndFeelTags          String[]
  lookAndFeelText          String?
  easeOfUseTags            String[]
  easeOfUseText            String?
  contentClarityTags       String[]
  contentClarityText       String?
  contentClarityQuoteTitle String?
  contentClarityQuoteText  String?
  trustTags                String[]
  trustText                String?
  accessibilityTags        String[]
  accessibilityText        String?
  accessibilityUrl         String?

  takeawayTags String[]
  takeawayText String?

  screens  Screen[]
  appEmbedding AppEmbedding?
  appFlows AppFlow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flow {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  status      Status    @default(DRAFT)
  screens     Screen[]
  appFlows    AppFlow[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AppFlow {
  id       String @id @default(uuid())
  appId    String
  flowId   String
  sequence Int    @default(0)
  app      App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  flow     Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([appId, flowId])
}

model Screen {
  id       String  @id @default(uuid())
  appId    String
  app      App     @relation(fields: [appId], references: [id])
  flowId   String?
  flow     Flow?   @relation(fields: [flowId], references: [id])
  screenNo Int?
  name     String
  slug     String  @unique
  imageUrl String

  // Screen Analysis Fields
  uxAnalysis         String?
  tonalityAndContent String?
  keyHighlights      String?
  evidenceWhoWhy     String?
  whereToUse         String?
  whereNotToUse      String?

  similarApps String[]
  uiElements  UiElement[]
  patterns    Pattern[]
  hotspots    Json?
  status      Status      @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  boardScreens BoardScreen[]
  screenEmbedding ScreenEmbedding?
  outboundEdges   ScreenEdge[]    @relation("SourceScreen")
  inboundEdges    ScreenEdge[]    @relation("TargetScreen")
  chatMessages ChatMessage[]
}

model UiElement {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String?
  status    Status   @default(DRAFT)
  screens   Screen[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pattern {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String?
  status    Status   @default(DRAFT)
  screens   Screen[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  REVIEWED
  COMPLETED
  REJECTED
}

model AppRequest {
  id          String        @id @default(uuid())
  email       String
  fullName    String
  productLink String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum UserTier {
  FREE
  PREMIUM
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model TierConfig {
  id                 String   @id @default(uuid())
  tier               UserTier @unique
  monthlyPromptLimit Int      @default(10)
  monthlyTokenLimit  Int      @default(100000)
  maxContextTokens   Int      @default(8192)
  updatedAt          DateTime @updatedAt
}

enum UserStatus {
  WAITLIST_PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model ClientUser {
  id                  String               @id // Maps to Supabase auth.users.id
  email               String               @unique
  name                String?
  phone               String?
  role                Role                 @default(VIEWER)
  status              UserStatus           @default(ACTIVE)
  creditsBalance      Int                  @default(0) // Invariant I1: welcome grant arrives as a ledger row
  tier                UserTier             @default(FREE) // Invariant I5: cache, written only by recomputeTier()
  tierOverride        UserTier?            // Admin VIP or team accounts
  tierOverrideUntil   DateTime?
  tierOverrideReason  String?
  welcomeGrantedAt    DateTime?
  permissions         String[]             @default([])
  usages              AiUsage[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  workspacesOwned      Workspace[]
  workspaceMemberships WorkspaceMember[]
  boardScreensAdded    BoardScreen[]
  chatMessages         ChatMessage[]
  aiChatSessions       AiChatSession[]
  aiFeedbacks          AiMessageFeedback[]
  subscriptions        UserSubscription[]
  creditReservations   CreditReservation[]
  creditLedgers        CreditLedger[]
  paymentTransactions  PaymentTransaction[]
  aiRequestLogs        AiRequestLog[]
  adminAuditsGiven     AdminAuditLog[]      @relation("AdminActor")
  adminAuditsReceived  AdminAuditLog[]      @relation("AdminTarget")
}

model AiUsage {
  id          String     @id @default(uuid())
  userId      String
  user        ClientUser @relation(fields: [userId], references: [id])
  month       Int
  year        Int
  promptsUsed Int        @default(0)
  tokensUsed  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, month, year])
}

model AiChatSession {
  id             String          @id @default(uuid())
  userId         String
  user           ClientUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String          @default("New Research")
  model          String          @default("claude-3-5-sonnet-20241022")
  systemPrompt   String?         @db.Text
  totalTokens    Int             @default(0)
  contextSummary String?         @db.Text
  messages       AiChatMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

model AiChatMessage {
  id                 String              @id @default(uuid())
  sessionId          String
  session            AiChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role               ChatRole
  content            String              @db.Text
  clientMessageId    String?
  metadata           Json?
  promptTokens       Int                 @default(0)
  completionTokens   Int                 @default(0)
  totalTokens        Int                 @default(0)
  isTrainingEligible Boolean             @default(true)
  feedbacks          AiMessageFeedback[]
  createdAt          DateTime            @default(now())

  @@unique([sessionId, clientMessageId])
  @@index([sessionId])
  @@index([isTrainingEligible])
}

model AiMessageFeedback {
  id             String        @id @default(uuid())
  messageId      String
  message        AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           ClientUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         Int           // 1 = Upvote, -1 = Downvote
  feedbackReason String?       // e.g. "Hallucination", "Off-topic", "Great UX insight"
  correctionText String?       @db.Text // User's corrected answer for AI learning
  createdAt      DateTime      @default(now())

  @@unique([messageId, userId])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     ClientUser @relation(fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  boards    Board[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        ClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("MEMBER") // e.g., OWNER, ADMIN, MEMBER
  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
}

model Board {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  screens     BoardScreen[]
  messages    ChatMessage[]
  canvasState Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BoardScreen {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  addedById String
  addedBy   ClientUser @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@unique([boardId, screenId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      ClientUser @relation(fields: [userId], references: [id])
  content   String
  
  // Optional reference to a specific screen if the comment is pinned to it
  screenId  String?
  screen    Screen?  @relation(fields: [screenId], references: [id], onDelete: SetNull)
  
  // Optional coordinates if it's a pin on the image itself
  x         Float?
  y         Float?
  
  createdAt DateTime @default(now())
}

model Integration {
  id        String   @id @default(uuid())
  provider  String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ScreenEmbedding {
  id           String                      @id @default(uuid())
  screenId     String                      @unique
  screen       Screen                      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  metadataText String                      @db.Text
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model AppEmbedding {
  id           String                      @id @default(uuid())
  appId        String                      @unique
  app          App                         @relation(fields: [appId], references: [id], onDelete: Cascade)
  metadataText String                      @db.Text
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model ScreenEdge {
  id             String   @id @default(uuid())
  sourceScreenId String
  targetScreenId String
  edgeType       String   // FLOW_SEQUENCE, SHARED_PATTERN, COMPETITOR_RIVAL
  weight         Float    @default(1.0)
  sourceScreen   Screen   @relation("SourceScreen", fields: [sourceScreenId], references: [id], onDelete: Cascade)
  targetScreen   Screen   @relation("TargetScreen", fields: [targetScreenId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([sourceScreenId, targetScreenId, edgeType])
  @@index([sourceScreenId])
  @@index([targetScreenId])
  @@index([edgeType])
}

// =========================================================================
// ZIBO PAYMENTS, CREDITS, LEDGER & SUBSCRIPTIONS (Satyajit Pujapanda Spec)
// =========================================================================

enum LedgerType {
  FREE_WELCOME_GRANT
  MONTHLY_SUBSCRIPTION_REFILL
  ROLLOVER_EXPIRY
  CREDIT_PACK_PURCHASE
  AI_QUERY_DEBIT
  SYSTEM_REFUND
  PAYMENT_REFUND_CLAWBACK
  ADMIN_MANUAL_GRANT
  ADMIN_MANUAL_DEDUCTION
  MIGRATION_BACKFILL
}

enum ReservationStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum SubscriptionStatus {
  INCOMPLETE // created or authenticated, first charge not confirmed
  ACTIVE
  PAST_DUE   // Razorpay state pending: charge failed, retries running
  HALTED     // retries exhausted
  PAUSED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  SUBSCRIPTION_MANDATE_INIT
  SUBSCRIPTION_RECURRING
  CREDIT_PACK_PURCHASE
  ADMIN_MANUAL
}

model CreditReservation {
  id             String            @id @default(uuid())
  userId         String
  user           ClientUser        @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestKey     String            // client Idempotency-Key, one per user
  actionType     String
  payloadHash    String            // same key with different payload is rejected
  cost           Int
  status         ReservationStatus @default(RESERVED)
  releaseReason  String?
  expiresAt      DateTime          // request hard timeout plus safety margin
  createdAt      DateTime          @default(now())
  settledAt      DateTime?

  @@unique([userId, requestKey])
  @@index([status, expiresAt])
}

model CreditLedger {
  id             String     @id @default(uuid())
  userId         String
  user           ClientUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountDelta    Int
  balanceAfter   Int
  type           LedgerType
  idempotencyKey String     @unique // namespaced: "debit:<userId>:<requestKey>", "pay:<razorpayPaymentId>"
  reservationId  String?
  paymentId      String?
  reason         String?
  adminId        String?
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model SubscriptionPlan {
  id          String      @id @default(uuid())
  code        String      @unique // "pro", "agency"
  name        String
  description String?
  prices      PlanPrice[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model PlanPrice {
  id             String           @id @default(uuid())
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  currency       String           // "INR" | "USD"
  amountMinor    Int              // paise or cents
  razorpayPlanId String           @unique
  isActive       Boolean          @default(true)
  monthlyCredits Int              @default(2500)
  subscriptions  UserSubscription[]
  transactions   PaymentTransaction[]

  @@unique([planId, currency, amountMinor])
}

model UserSubscription {
  id                 String             @id @default(uuid())
  userId             String
  user               ClientUser         @relation(fields: [userId], references: [id], onDelete: Restrict)
  planPriceId        String
  price              PlanPrice          @relation(fields: [planPriceId], references: [id])
  razorpaySubId      String             @unique
  status             SubscriptionStatus @default(INCOMPLETE)
  razorpayStatus     String?            // raw value kept for debugging
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?          // unknown until first charge
  entitledUntil      DateTime?          // access boundary, includes any grace
  cancelAtPeriodEnd  Boolean            @default(false)
  lastEventAt        DateTime?          // newest applied event timestamp, guards out-of-order delivery
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id                     String           @id @default(uuid())
  userId                 String
  user                   ClientUser       @relation(fields: [userId], references: [id], onDelete: Restrict)
  planPriceId            String?
  planPrice              PlanPrice?       @relation(fields: [planPriceId], references: [id], onDelete: SetNull)
  amount                 Int              // minor units: paise or cents
  currency               String           @default("INR")
  status                 PaymentStatus    @default(PENDING)
  paymentType            PaymentType      @default(SUBSCRIPTION_RECURRING)
  razorpayOrderId        String?
  razorpayPaymentId      String?          @unique
  razorpaySubscriptionId String?
  razorpaySignature      String?
  creditsGranted         Int              @default(0)
  paymentMethod          String?          // "upi", "card", "netbanking"
  rawWebhookPayload      Json?
  errorCode              String?
  errorDescription       String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([razorpayOrderId])
  @@index([razorpaySubscriptionId])
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique // x-razorpay-event-id
  event       String
  entityId    String?
  payload     Json
  processedAt DateTime @default(now())
}

model PaymentWebhookFailure {
  id          String    @id @default(uuid())
  eventId     String
  event       String?
  payload     Json
  error       String
  attempts    Int       @default(1)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([resolvedAt])
}

model AdminAuditLog {
  id           String      @id @default(uuid())
  adminId      String
  admin        ClientUser  @relation("AdminActor", fields: [adminId], references: [id])
  action       String      // "credits.adjust", "tier.override", "app.premium_toggle"
  targetUserId String?
  targetUser   ClientUser? @relation("AdminTarget", fields: [targetUserId], references: [id])
  before       Json?
  after        Json?
  reason       String
  requestKey   String      @unique
  createdAt    DateTime    @default(now())
}

model AiRequestLog {
  id                  String     @id @default(uuid())
  userId              String
  user                ClientUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId           String?
  clientMessageId     String     @unique // Idempotency key from client
  actionType          String     // "WORKSPACE_CHAT", "BENCHMARK", etc.
  model               String     // "claude-sonnet-4-5-20250929"
  inputTokens         Int
  outputTokens        Int
  cacheCreationTokens Int        @default(0)
  cacheReadTokens     Int        @default(0)
  costUsd             Decimal    @db.Decimal(10, 6) // Invariant: Decimal for cost, avoiding float drift
  creditsDeducted     Int
  createdAt           DateTime   @default(now())

  @@index([userId, createdAt])
}
