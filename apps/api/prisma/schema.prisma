generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  LIVE
  DRAFT
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Category {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String?
  status        Status        @default(DRAFT)
  apps          App[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  title       String
  slug        String   @unique
  description String?
  status      Status   @default(DRAFT)
  apps        App[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model App {
  id            String       @id @default(uuid())
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  name          String
  slug          String       @unique
  appLogo       String
  appThumbnail  String
  status        Status       @default(DRAFT)
  isStaffPick   Boolean      @default(false)
  sourceUrl     String?
  description   String?
  platform      String[]
  tags          String[]
  palette       Json?

  market         String[]
  targetAudience String?

  // Deep Dive Analysis
  visualUiTypography String?
  visualUiShape      String?
  visualUiImagery    String?

  experienceUxSolves  String?
  experienceUxOverall String?
  experienceUxTone    String?

  lookAndFeelTags          String[]
  lookAndFeelText          String?
  easeOfUseTags            String[]
  easeOfUseText            String?
  contentClarityTags       String[]
  contentClarityText       String?
  contentClarityQuoteTitle String?
  contentClarityQuoteText  String?
  trustTags                String[]
  trustText                String?
  accessibilityTags        String[]
  accessibilityText        String?
  accessibilityUrl         String?

  takeawayTags String[]
  takeawayText String?

  screens  Screen[]
  appEmbedding AppEmbedding?
  appFlows AppFlow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flow {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  status      Status    @default(DRAFT)
  screens     Screen[]
  appFlows    AppFlow[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AppFlow {
  id       String @id @default(uuid())
  appId    String
  flowId   String
  sequence Int    @default(0)
  app      App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  flow     Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([appId, flowId])
}

model Screen {
  id       String  @id @default(uuid())
  appId    String
  app      App     @relation(fields: [appId], references: [id])
  flowId   String?
  flow     Flow?   @relation(fields: [flowId], references: [id])
  screenNo Int?
  name     String
  slug     String  @unique
  imageUrl String

  // Screen Analysis Fields
  uxAnalysis         String?
  tonalityAndContent String?
  keyHighlights      String?
  evidenceWhoWhy     String?
  whereToUse         String?
  whereNotToUse      String?

  similarApps String[]
  uiElements  UiElement[]
  patterns    Pattern[]
  hotspots    Json?
  status      Status      @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  boardScreens BoardScreen[]
  screenEmbedding ScreenEmbedding?
  outboundEdges   ScreenEdge[]    @relation("SourceScreen")
  inboundEdges    ScreenEdge[]    @relation("TargetScreen")
  chatMessages ChatMessage[]
}

model UiElement {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String?
  status    Status   @default(DRAFT)
  screens   Screen[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pattern {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String?
  status    Status   @default(DRAFT)
  screens   Screen[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  REVIEWED
  COMPLETED
  REJECTED
}

model AppRequest {
  id          String        @id @default(uuid())
  email       String
  fullName    String
  productLink String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum UserTier {
  FREE
  PREMIUM
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model TierConfig {
  id                 String   @id @default(uuid())
  tier               UserTier @unique
  monthlyPromptLimit Int      @default(10)
  monthlyTokenLimit  Int      @default(100000)
  maxContextTokens   Int      @default(8192)
  updatedAt          DateTime @updatedAt
}

enum UserStatus {
  WAITLIST_PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model ClientUser {
  id          String        @id // Maps to Supabase auth.users.id
  email       String        @unique
  name        String?
  phone       String?
  role        Role          @default(VIEWER)
  status      UserStatus    @default(ACTIVE)
  tier        UserTier      @default(FREE)
  permissions String[]      @default([])
  usages      AiUsage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspacesOwned      Workspace[]
  workspaceMemberships WorkspaceMember[]
  boardScreensAdded    BoardScreen[]
  chatMessages         ChatMessage[]
  aiChatSessions       AiChatSession[]
  aiFeedbacks          AiMessageFeedback[]
}

model AiUsage {
  id          String     @id @default(uuid())
  userId      String
  user        ClientUser @relation(fields: [userId], references: [id])
  month       Int
  year        Int
  promptsUsed Int        @default(0)
  tokensUsed  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, month, year])
}

model AiChatSession {
  id             String          @id @default(uuid())
  userId         String
  user           ClientUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String          @default("New Research")
  model          String          @default("claude-3-5-sonnet-20241022")
  systemPrompt   String?         @db.Text
  totalTokens    Int             @default(0)
  contextSummary String?         @db.Text
  messages       AiChatMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

model AiChatMessage {
  id                 String              @id @default(uuid())
  sessionId          String
  session            AiChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role               ChatRole
  content            String              @db.Text
  metadata           Json?
  promptTokens       Int                 @default(0)
  completionTokens   Int                 @default(0)
  totalTokens        Int                 @default(0)
  isTrainingEligible Boolean             @default(true)
  feedbacks          AiMessageFeedback[]
  createdAt          DateTime            @default(now())

  @@index([sessionId])
  @@index([isTrainingEligible])
}

model AiMessageFeedback {
  id             String        @id @default(uuid())
  messageId      String
  message        AiChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           ClientUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating         Int           // 1 = Upvote, -1 = Downvote
  feedbackReason String?       // e.g. "Hallucination", "Off-topic", "Great UX insight"
  correctionText String?       @db.Text // User's corrected answer for AI learning
  createdAt      DateTime      @default(now())

  @@unique([messageId, userId])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     ClientUser @relation(fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  boards    Board[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        ClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("MEMBER") // e.g., OWNER, ADMIN, MEMBER
  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
}

model Board {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  screens     BoardScreen[]
  messages    ChatMessage[]
  canvasState Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BoardScreen {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  addedById String
  addedBy   ClientUser @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@unique([boardId, screenId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      ClientUser @relation(fields: [userId], references: [id])
  content   String
  
  // Optional reference to a specific screen if the comment is pinned to it
  screenId  String?
  screen    Screen?  @relation(fields: [screenId], references: [id], onDelete: SetNull)
  
  // Optional coordinates if it's a pin on the image itself
  x         Float?
  y         Float?
  
  createdAt DateTime @default(now())
}

model Integration {
  id        String   @id @default(uuid())
  provider  String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ScreenEmbedding {
  id           String                      @id @default(uuid())
  screenId     String                      @unique
  screen       Screen                      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  metadataText String                      @db.Text
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model AppEmbedding {
  id           String                      @id @default(uuid())
  appId        String                      @unique
  app          App                         @relation(fields: [appId], references: [id], onDelete: Cascade)
  metadataText String                      @db.Text
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model ScreenEdge {
  id             String   @id @default(uuid())
  sourceScreenId String
  targetScreenId String
  edgeType       String   // FLOW_SEQUENCE, SHARED_PATTERN, COMPETITOR_RIVAL
  weight         Float    @default(1.0)
  sourceScreen   Screen   @relation("SourceScreen", fields: [sourceScreenId], references: [id], onDelete: Cascade)
  targetScreen   Screen   @relation("TargetScreen", fields: [targetScreenId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([sourceScreenId, targetScreenId, edgeType])
  @@index([sourceScreenId])
  @@index([targetScreenId])
  @@index([edgeType])
}
